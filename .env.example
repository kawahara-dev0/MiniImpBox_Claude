DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=miniimpbox
POSTGRES_USER=miniimpbox
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-this-admin-password
# BACKUP_GPG_PASSPHRASE must be stored in a separate secure location (e.g., password manager).
# Do NOT store it only in this file on the trial host.
BACKUP_GPG_PASSPHRASE=change-this-backup-passphrase
# WARNING: 'docker compose down --volumes' destroys the pgdata volume and ALL data.
# Do NOT run this in normal operations. Use 'docker compose down' (without --volumes) to stop.
